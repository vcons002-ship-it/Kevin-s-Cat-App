# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv created by setup.sh
venv/
.venv/

# Local runtime config (written by the GUI from config.example.yaml)
config.yaml

# User-uploaded sounds (keep only the bundled default chime)
d20app/sounds/*
!d20app/sounds/generate_chime.py
!d20app/sounds/treat_chime.wav

# Runtime activity log (written by the app)
activity.log

# Cat sightings log (written by the app)
cats.log

# Opt-in fusion diagnostics (#110), written only while fusion_debug is on
fusion_events.jsonl

# Diagnostic snapshot from check_camera.py
snapshot.jpg

# Detection snapshots written at runtime
snapshots/
# Cat sightings, one file per day (unbounded history)
cats/
cats.log.migrated
# Screenshots taken by hand from the live feed (kept, never pruned)
screenshots/

# This machine's model provenance (#109): entries for files generated/adopted
# here. Deliberately NOT committed, so a `git reset --hard` refreshes the repo
# manifest without wiping local provenance and re-flagging valid local models.
d20app/models/models_manifest.local.json
